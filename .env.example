# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service-role key: server-only, NEVER prefix with NEXT_PUBLIC_, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL (used for metadata, sitemap, robots, OG images)
NEXT_PUBLIC_SITE_URL=https://rdtravel.mx

# Random long string used to salt IP hashes for lead rate-limiting (any value works)
# Generate one with: openssl rand -base64 32
LEAD_HASH_SALT=change-me-to-a-random-string

# Fase 2/3 — pixels de conversión (opcionales, dejar vacíos por ahora)
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# Notificacion por correo de leads nuevos — resend.com → API Keys
RESEND_API_KEY=
LEAD_NOTIFICATION_EMAIL=
